{
  "Keycloak": {
    "Authority": "http://localhost:8082/realms/products-realm",
    "MetadataAddress": "http://keycloak:8080/realms/products-realm/.well-known/openid-configuration",
    "Audience": "products-api",
    "RequireHttpsMetadata": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=products_postgres;Port=5432;Database=products_db;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "InstanceName": "ProductsAPI_"
  },
  "AllowedHosts": "*"
}
