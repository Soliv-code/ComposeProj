# ==========================================
# PostgreSQL Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=products_db

# ==========================================
# API Connection String Variables
# (Используются в docker-compose.yml для сборки строки подключения)
# ==========================================
DB_HOST=products_postgres
DB_PORT=5432
DB_NAME=products_db
DB_USER=postgres
DB_PASSWORD=postgres
# ==========================================
# Redis переменные среды (Используется в docker-compose.yml для сборки подключения)
# ==========================================
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=ProductsAPI_